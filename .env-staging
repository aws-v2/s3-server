APP_PROFILE=staging
SERVER_PORT=8099

# PostgreSQL
POSTGRES_HOST=postgres-staging
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=staging_db_password
POSTGRES_DB=s3
POSTGRES_SSL_MODE=disable

# NATS
NATS_URL=nats://nats-staging:4222
NATS_USER=auth-server
NATS_PASSWORD=auth-secret

# MinIO
MINIO_ENDPOINT=minio-staging:9000
MINIO_ACCESS_KEY=staging_minio_access_key
MINIO_SECRET_KEY=staging_minio_secret_key
MINIO_USE_SSL=false

# Eureka
EUREKA_SERVER_URL=http://eureka-staging:8761/eureka
EUREKA_APP_NAME=S3-SERVICE
EUREKA_HOSTNAME=s3-server-staging
EUREKA_IP_ADDR=127.0.0.1
EUREKA_VIP_ADDRESS=s3-service
EUREKA_INSTANCE_ID=s3-service-staging:8099
