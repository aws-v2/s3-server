APP_PROFILE=prod
SERVER_PORT=8099

# PostgreSQL
POSTGRES_HOST=postgres-prod
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=prod_db_password
POSTGRES_DB=s3
POSTGRES_SSL_MODE=disable

# NATS
NATS_URL=nats://nats-prod:4222
NATS_USER=auth-server
NATS_PASSWORD=prod_nats_password

# MinIO
MINIO_ENDPOINT=minio-prod:9000
MINIO_ACCESS_KEY=prod_minio_access_key
MINIO_SECRET_KEY=prod_minio_secret_key
MINIO_USE_SSL=true

# Eureka
EUREKA_SERVER_URL=http://eureka-prod:8761/eureka
EUREKA_APP_NAME=S3-SERVICE
EUREKA_HOSTNAME=s3-server-prod
EUREKA_IP_ADDR=127.0.0.1
EUREKA_VIP_ADDRESS=s3-service
EUREKA_INSTANCE_ID=s3-service-prod:8099
